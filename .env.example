# Build-time — bundled into the client by Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Runtime — read by the Netlify Edge Function that renders per-duel Open Graph
# tags (netlify/edge-functions/og.js). Same two values as above, without the
# VITE_ prefix: edge functions run in Deno and never see the Vite bundle's env.
# On Netlify these live in the project's env vars (netlify env:set), not here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
